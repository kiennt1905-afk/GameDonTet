--- !u!114 &775339014
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 775339012}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea6a4641c46a87041b5e0fe127f2d79f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines:
  - speakerName: "Minh (Ng\u01B0\u1EDDi ch\u01A1i)"
    dialogueText: "\xD4ng b\xE0 \u01A1i! Ch\xE1u v\u1EC1 r\u1ED3i \u0111\xE2y \u1EA1"
    audioClip: {fileID: 8300000, guid: 8f607aeaa59a463469402a5f41f4a9d7, type: 3}
  - speakerName: "\xD4ng"
    dialogueText: "\xD4i th\u1EB1ng Minh, v\u1EC1 r\xF4i \u0111\u1EA5y \xE0! B\u1ED1
      m\u1EB9 ch\xE1u \u0111\xE2u m\xE0 \u0111\u1EC3 th\u1EB1ng con \u0111i m\xF4\u1EF5
      m\xECnh th\u1EBF n\xE0y!"
    audioClip: {fileID: 8300000, guid: 5b4f433bc67ab8841857230a0f5f1769, type: 3}
  - speakerName: "Minh (Ng\u01B0\u1EDDi ch\u01A1i)"
    dialogueText: "D\u1EA1 s\xE1ng s\u01A1m c\xF4ng ty b\u1ED1 m\u1EB9 c\xF3 vi\u1EC7c
      \u0111\u1ED9t xu\u1EA5t ph\u1EA3i \u0111i c\xF4ng t\xE1c g\u1EA5p m\u1EA5t
      r\u1ED3i \u1EA1."
    audioClip: {fileID: 8300000, guid: cbfc5608e3ad4e949be443bbe0ce6139, type: 3}
  - speakerName: "Minh (Ng\u01B0\u1EDDi ch\u01A1i)"
    dialogueText: "B\u1ED1 m\u1EB9 g\u1EEDi l\u1EDDi xin l\u1ED7i \xF4ng b\xE0 v\xE0
      d\u1EB7n ch\xE1u qua ph\u1EE5 d\u1ECDn d\u1EB9p \u0111\xF3n t\u1EBFt \u1EA1."
    audioClip: {fileID: 8300000, guid: e682ec1a40d417d44a5876e2b2082ac3, type: 3}
  - speakerName: "\xD4ng"
    dialogueText: "Th\xF4i, v\xE0o nh\xE0 \u0111i con. \xD4ng b\xE0 \u0111i n\u1EA5u
      b\xE1nh  ch\u01B0ng, con lau b\u1ED9 gh\u1EBF g\u1ED7 xong r\u1ED3i c\u1EA3
      nh\xE0 ta c\xF9ng g\xF3i b\xE1nh \u0111\u1EC3 \u0111i t\u1EB7ng cho b\xE0 con
      \u0103n t\u1EBFt. "
    audioClip: {fileID: 8300000, guid: f4bb0b315442ff24bbc6732bf6dfcc84, type: 3}
  - speakerName: "Minh (Ng\u01B0\u1EDDi ch\u01A1i)"
    dialogueText: "D\u1EA1 v\xE2ng \u1EA1."
    audioClip: {fileID: 8300000, guid: fe6c1787df0b88e459fcf5f8da04ceeb, type: 3}
